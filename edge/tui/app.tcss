Screen {
    background: $background;
}

/* Main menu (title screen) */
MainMenuScreen {
    layers: stars menu;
    align: center middle;
}

MainMenuScreen Starfield {
    layer: stars;
}

#menu-box {
    layer: menu;
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#menu-box .title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $primary;
}

#menu-box .subtitle {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#menu-box #menu-items {
    height: auto;
    align: center middle;
}

#menu-box Button {
    width: 40;
    height: 1;
    border: none;
    margin-bottom: 1;
}

#menu-box .save-card {
    align: center middle;
    height: auto;
    border: round $primary;
    border-title-color: $primary;
    padding: 0 1;
    margin: 0 4 1 4;
    color: $text-muted;
}

#menu-box .footer {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#body {
    height: 1fr;
}

/* Shared modal sizing (WP-UI05/WP-UI07): every dialog box uses this class so
   modals stay usable at 80×24 instead of each screen guessing its own bounds.
   Widths are standardized per layout tier (the tier class sits on the modal
   screen itself), and bodies scroll rather than clip when the terminal is
   short — no modal may ever exceed an 80×24 screen. */
.modal-box {
    width: 56;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    overflow-y: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.compact .modal-box {
    width: 72;
    max-height: 100%;
}

.wide .modal-box {
    width: 64;
}

/* Port screen */
#port-body {
    padding: 1 2;
}

#commodities {
    height: auto;
    max-height: 8;
}

#port-footer {
    margin-top: 1;
    color: $text-muted;
}
